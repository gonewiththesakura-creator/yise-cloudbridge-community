# Non-secret host-specific inputs. Replace all /srv/example paths and example.invalid.
# Node supports --env-file. Shell helpers consume exported variables, not shell-source files.
CB_APP_DIR=/srv/example/cloudbridge/app
CB_DATA_DIR=/srv/example/cloudbridge/data
CB_DATABASE_PATH=/srv/example/cloudbridge/data/friendlink.db
CB_CONFIG_FILE=/srv/example/cloudbridge/config/app.env
DEPLOY_ENV_FILE=/srv/example/cloudbridge/config/deployment.env
CB_BACKUP_DIR=/srv/example/cloudbridge/backups
CB_USER=cloudbridge
CB_GROUP=cloudbridge
BACKUP_USER=root
BACKUP_GROUP=root
NODE_BIN=/usr/bin/node
BASH_BIN=/bin/bash

SUI_USER=sui
SUI_GROUP=sui
SUI_APP_DIR=/srv/example/s-ui
SUI_BINARY_PATH=/srv/example/s-ui/sui
SUI_DATA_DIR=/srv/example/s-ui/db
# Empty omits the optional S-UI snapshot. Set an explicit path to include it.
SUI_DATABASE_PATH=

PUBLIC_HOST=proxy.example.invalid
HTTP_PORT=80
CONSOLE_TLS_PORT=8443
HOST=127.0.0.1
PORT=8787
DATA_PLANE_PORT=443
ACME_WEBROOT=/srv/example/acme
DOWNLOADS_DIR=/srv/example/cloudbridge/downloads
DATA_PLANE_CERT_PATH=/srv/example/cloudbridge/tls/fullchain.pem
DATA_PLANE_KEY_PATH=/srv/example/cloudbridge/tls/privkey.pem
DEVICE_CA_DIR=/srv/example/cloudbridge/device-ca
BACKUP_PASSPHRASE_FILE=/srv/example/cloudbridge/config/backup.pass
# No pruning by default. Set a positive number of days to opt in during --apply.
BACKUP_RETENTION_DAYS=

# Certbot sets RENEWED_LINEAGE when the reviewed hook is invoked after renewal.
CERT_OWNER=root
CERT_GROUP=cloudbridge
PROXY_SERVER_NAME=proxy.example.invalid
CERT_RESTART_UNITS="cloudbridge.service s-ui.service"
CERT_RELOAD_UNITS=nginx.service
