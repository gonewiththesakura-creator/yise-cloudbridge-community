{
  "name": "cloudbridge-console",
  "version": "2.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-source.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "10.0.5",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2"
  },
  "packageManager": "npm@11.9.0",
  "license": "GPL-3.0-or-later"
}
