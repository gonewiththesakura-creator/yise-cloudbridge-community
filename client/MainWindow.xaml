<Window x:Class="CloudBridge.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CloudBridge.Client"
        Title="壹色云桥" Width="960" Height="750" Icon="Assets/YiseCloudBridge.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" UseLayoutRounding="True">
  <Window.Resources>
    <Storyboard x:Key="ConnectedPulse" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="ConnectPulseRing" Storyboard.TargetProperty="Opacity" From="0.42" To="0" Duration="0:0:1.8" />
      <DoubleAnimation Storyboard.TargetName="ConnectPulseRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.94" To="1.18" Duration="0:0:1.8" />
      <DoubleAnimation Storyboard.TargetName="ConnectPulseRing" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.94" To="1.18" Duration="0:0:1.8" />
    </Storyboard>
    <Storyboard x:Key="BusySpin" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="ConnectGlyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.85" />
    </Storyboard>
    <Style x:Key="RouteButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Height" Value="76" /><Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#70FFFFFF" /><Setter Property="BorderBrush" Value="#BBFFFFFF" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15" RenderTransformOrigin="0.5,0.5">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#EAFFFFFF" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98" /></Setter.Value></Setter></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.48" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
  <Border Width="932" Height="722" Margin="14" CornerRadius="26" Background="{StaticResource PageBrush}" BorderBrush="#EBFFFFFF" BorderThickness="1">
    <Border.Effect><DropShadowEffect Color="#4A648B" BlurRadius="26" ShadowDepth="6" Opacity="0.23" /></Border.Effect>
    <Grid ClipToBounds="True">
      <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="34" /></Grid.RowDefinitions>
      <Grid Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True" Margin="20">
        <Ellipse Width="420" Height="370" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-100,-60,0" Opacity="0.52"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#B7DEFF" Offset="0"/><GradientStop Color="#00B7DEFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
        <Ellipse Width="430" Height="410" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="70,0,0,-70" Opacity="0.46"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#C7BDF5" Offset="0"/><GradientStop Color="#00C7BDF5" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
        <Ellipse Width="390" Height="340" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.42"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#AFECE3" Offset="0"/><GradientStop Color="#00AFECE3" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
      </Grid>

      <Border Grid.Row="0" Background="#45FFFFFF" CornerRadius="26,26,0,0" BorderBrush="#75FFFFFF" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="16,0,10,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="Assets/YiseCloudBridge.png" Width="30" Height="30" Margin="1,0,9,0" />
            <TextBlock Text="YISE" FontSize="11" FontWeight="SemiBold" Foreground="#62768F" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="壹色云桥" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#51637B" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="StatusBadge" Padding="9,4" CornerRadius="8" Background="#EEEEF0" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal"><Ellipse x:Name="HeaderStatusDot" Width="6" Height="6" Fill="#8E8E93" Margin="0,0,6,0" VerticalAlignment="Center" /><TextBlock x:Name="HeaderStatusText" Text="未连接" Foreground="#6E6E73" FontSize="10" /></StackPanel>
            </Border>
            <Button Style="{StaticResource IconButton}" Click="MinimizeButton_Click" ToolTip="最小化"><TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="10" /></Button>
            <Button Style="{StaticResource IconButton}" Click="CloseButton_Click" ToolTip="隐藏到右下角托盘，网络连接保持"><TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="11" /></Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" x:Name="ActivationPanel" Visibility="Collapsed">
        <Grid Width="430" VerticalAlignment="Center" Margin="30">
          <StackPanel>
            <Image Source="Assets/YiseCloudBridge.png" Width="90" Height="90" HorizontalAlignment="Center" />
            <TextBlock Text="绑定这台电脑" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0" />
            <TextBlock Text="输入管理员提供的一次性激活码" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,7,0,0" />
            <Border Style="{StaticResource PanelBorder}" Padding="24" Margin="0,28,0,0">
              <StackPanel>
                <TextBlock Text="激活码" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="ActivationCodeBox" Height="50" Padding="14,8" Margin="0,8,0,0" FontFamily="Consolas" FontSize="18" CharacterCasing="Upper" MaxLength="14" />
                <Button x:Name="ActivateButton" Height="46" Margin="0,14,0,0" Style="{StaticResource PrimaryButton}" Click="ActivateButton_Click">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" Foreground="White" Margin="0,0,8,0" /><TextBlock Text="绑定并继续" Foreground="White" FontWeight="SemiBold" /></StackPanel>
                </Button>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
              <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="#28A745" Margin="0,0,7,0" />
              <TextBlock x:Name="ActivationKeyProviderText" Foreground="{StaticResource MutedBrush}" FontSize="10" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Grid>

      <Grid Grid.Row="1" x:Name="DashboardPanel" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="184" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="#28FFFFFF" BorderBrush="#70FFFFFF" BorderThickness="0,0,1,0">
          <Grid Margin="14,18,14,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="26" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Margin="8,0,0,0">
              <TextBlock Text="自由连接" FontSize="21" FontWeight="SemiBold" />
              <TextBlock Text="YISE CLOUD BRIDGE" Foreground="#8B9AB0" FontSize="8" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="2">
              <Button x:Name="NavConnectionButton" Style="{StaticResource NavButton}" Click="NavConnectionButton_Click" Background="#FFFFFF" Foreground="#007AFF">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="16" Width="28" /><TextBlock Text="连接" FontSize="12" FontWeight="SemiBold" /></StackPanel>
              </Button>
              <Button x:Name="NavTrafficButton" Style="{StaticResource NavButton}" Click="NavTrafficButton_Click" Margin="0,5,0,0">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons" FontSize="16" Width="28" /><TextBlock Text="流量" FontSize="12" /></StackPanel>
              </Button>
              <Button x:Name="NavAccountButton" Style="{StaticResource NavButton}" Click="NavAccountButton_Click" Margin="0,5,0,0">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="16" Width="28" /><TextBlock Text="设备" FontSize="12" /></StackPanel>
              </Button>
            </StackPanel>
            <Border Grid.Row="4" Background="#85FFFFFF" BorderBrush="#CFFFFFFF" BorderThickness="1" CornerRadius="16" Padding="13">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="14" Background="#E8F2FF"><TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" Foreground="#007AFF" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="SidebarMemberText" Text="—" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="SidebarExpiryText" Text="—" Foreground="#8E8E93" FontSize="8" Margin="0,2,0,0" /></StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="26,24,26,18">
          <Grid x:Name="ConnectionView">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="22" /><RowDefinition Height="250" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid>
              <StackPanel><TextBlock x:Name="WelcomeText" Text="专线控制台" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="美国洛杉矶 · US-LAX-ISP-1" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel>
              <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EAF7ED" CornerRadius="8" Padding="10,6"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="#28A745" FontSize="12" Margin="0,0,6,0" /><TextBlock Text="设备凭据有效" Foreground="#247C38" FontSize="10" /></StackPanel></Border>
            </Grid>

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="0.88*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="1.12*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource PanelBorder}" Padding="22">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <StackPanel><TextBlock Text="轻触，即刻连接" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="ConnectionDetailText" Text="系统代理当前未启用" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                  <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="148" Height="148" Fill="#18FFFFFF" Stroke="#AFFFFFFF" StrokeThickness="1" />
                    <Ellipse x:Name="ConnectPulseRing" Width="136" Height="136" Stroke="#54AED9" StrokeThickness="1.5" Opacity="0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform></Ellipse>
                    <Button x:Name="ConnectButton" Width="124" Height="124" Padding="0" Background="{StaticResource ConnectBrush}" BorderThickness="0" Click="ConnectButton_Click" ToolTip="连接专线">
                      <Button.Template><ControlTemplate TargetType="Button"><Grid x:Name="Circle" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform><Ellipse Fill="{TemplateBinding Background}" Stroke="#CEFFFFFF" StrokeThickness="1.5"><Ellipse.Effect><DropShadowEffect Color="#5997E9" BlurRadius="25" ShadowDepth="7" Opacity="0.32" /></Ellipse.Effect></Ellipse><Ellipse Margin="5" Stroke="#45FFFFFF" StrokeThickness="1"/><Ellipse Margin="6"><Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#58FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.58"/></LinearGradientBrush></Ellipse.Fill></Ellipse><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Circle" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.18"/><DoubleAnimation Storyboard.TargetName="Circle" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Circle" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18"/><DoubleAnimation Storyboard.TargetName="Circle" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Opacity" Value="0.75" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Circle" Property="Opacity" Value="0.5" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                      <StackPanel><TextBlock x:Name="ConnectGlyph" Text="&#xE7E8;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="31" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform Angle="0" /></TextBlock.RenderTransform></TextBlock><TextBlock x:Name="ConnectionTitleText" Text="连接" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,9,0,0" /></StackPanel>
                    </Button>
                  </Grid>
                  <TextBlock Grid.Row="2" x:Name="CurrentRouteText" Text="VLESS · TCP 稳定线路" Foreground="{StaticResource MutedBrush}" FontSize="9" HorizontalAlignment="Center" />
                </Grid>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="18">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="76" /><RowDefinition Height="8" /><RowDefinition Height="34" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid><TextBlock Text="线路" FontSize="14" FontWeight="SemiBold" /><Button x:Name="TestRoutesButton" HorizontalAlignment="Right" Height="30" MinHeight="30" Padding="10,4" Style="{StaticResource SecondaryButton}" Click="TestRoutesButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" Margin="0,0,5,0" /><TextBlock x:Name="TestRoutesText" Text="智能测速" FontSize="9" /></StackPanel></Button></Grid>
                  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="VlessRouteButton" Grid.Column="0" Style="{StaticResource RouteButton}" Click="VlessRouteButton_Click" BorderBrush="#007AFF" BorderThickness="2">
                      <Grid Margin="12,10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><Border Width="28" Height="28" CornerRadius="7" Background="#E8F2FF" HorizontalAlignment="Left"><TextBlock Text="&#xE968;" FontFamily="Segoe Fluent Icons" Foreground="#007AFF" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock x:Name="VlessSelectedMark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="#007AFF" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid><StackPanel Grid.Row="1" VerticalAlignment="Bottom"><TextBlock Text="VLESS" FontSize="11" FontWeight="SemiBold" /><TextBlock x:Name="VlessSpeedText" Text="TCP · 稳定" Foreground="#8E8E93" FontSize="8" Margin="0,2,0,0" /></StackPanel></Grid>
                    </Button>
                    <Button x:Name="TuicRouteButton" Grid.Column="2" Style="{StaticResource RouteButton}" Click="TuicRouteButton_Click">
                      <Grid Margin="12,10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><Border Width="28" Height="28" CornerRadius="7" Background="#E8F8FA" HorizontalAlignment="Left"><TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons" Foreground="#30B0C7" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock x:Name="TuicSelectedMark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="#30B0C7" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" /></Grid><StackPanel Grid.Row="1" VerticalAlignment="Bottom"><TextBlock Text="TUIC" FontSize="11" FontWeight="SemiBold" /><TextBlock x:Name="TuicSpeedText" Text="QUIC · 低延迟" Foreground="#8E8E93" FontSize="8" Margin="0,2,0,0" /></StackPanel></Grid>
                    </Button>
                  </Grid>
                  <Border Grid.Row="4" Background="#80E2EAF4" CornerRadius="11" Padding="3">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Button x:Name="BypassModeButton" Height="28" MinHeight="28" Padding="6,2" Background="White" BorderThickness="0" Click="BypassModeButton_Click" ToolTip="中国大陆网站直连，其他流量使用当前线路">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="绕过大陆" FontSize="9" /></StackPanel>
                      </Button>
                      <Button x:Name="GlobalModeButton" Grid.Column="1" Height="28" MinHeight="28" Padding="6,2" Background="Transparent" BorderThickness="0" Click="GlobalModeButton_Click" ToolTip="通过 TUN 接管所有应用流量，需要管理员权限">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE95B;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="全局 TUN" FontSize="9" /></StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                  <TextBlock Grid.Row="6" x:Name="RouteHintText" Text="可手动选择，测速后会推荐更快线路" Foreground="#8E8E93" FontSize="8" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Border>
            </Grid>

            <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Padding="18,14">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid><StackPanel Orientation="Horizontal"><TextBlock Text="实时流量" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="ChartWindowText" Text="  最近 60 秒" Foreground="#8E8E93" FontSize="9" VerticalAlignment="Bottom" Margin="5,0,0,1" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#007AFF" VerticalAlignment="Center" /><TextBlock x:Name="LiveDownText" Text="下载 0 Kbps" Foreground="#6E6E73" FontSize="9" Margin="5,0,14,0" /><Ellipse Width="7" Height="7" Fill="#30B0C7" VerticalAlignment="Center" /><TextBlock x:Name="LiveUpText" Text="上传 0 Kbps" Foreground="#6E6E73" FontSize="9" Margin="5,0,0,0" /></StackPanel></Grid>
                <local:TrafficChart x:Name="OverviewTrafficChart" Grid.Row="1" Height="104" Margin="0,10,0,8" />
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="本次下载" Foreground="#8E8E93" FontSize="8" /><TextBlock x:Name="SessionDownloadText" Text="0 B" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" /></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="本次上传" Foreground="#8E8E93" FontSize="8" /><TextBlock x:Name="SessionUploadText" Text="0 B" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" /></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="套餐用量" Foreground="#8E8E93" FontSize="8" /><TextBlock x:Name="UsagePercentText" Text="—" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" /></StackPanel>
                  <StackPanel Grid.Column="3"><TextBlock Text="剩余时间" Foreground="#8E8E93" FontSize="8" /><TextBlock x:Name="DaysRemainingText" Text="—" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" /></StackPanel>
                </Grid>
              </Grid>
            </Border>
          </Grid>

          <Grid x:Name="TrafficView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /><RowDefinition Height="14" /><RowDefinition Height="112" /></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="流量统计" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="本机会话实时数据与服务端套餐累计" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel>
            <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="22">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid><TextBlock Text="实时速度" FontSize="14" FontWeight="SemiBold" /><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock x:Name="TrafficLiveDownText" Text="↓ 0 Kbps" Foreground="#007AFF" FontSize="11" Margin="0,0,18,0" /><TextBlock x:Name="TrafficLiveUpText" Text="↑ 0 Kbps" Foreground="#30B0C7" FontSize="11" /></StackPanel></Grid>
                <local:TrafficChart x:Name="DetailTrafficChart" Grid.Row="1" Margin="0,20,0,12" />
                <TextBlock Grid.Row="2" Text="60 秒前" Foreground="#8E8E93" FontSize="8" /><TextBlock Grid.Row="2" Text="现在" Foreground="#8E8E93" FontSize="8" HorizontalAlignment="Right" />
              </Grid>
            </Border>
            <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource PanelBorder}" Padding="15"><StackPanel><TextBlock Text="本机今日" Foreground="#8E8E93" FontSize="9" /><TextBlock x:Name="TodayTrafficText" Text="0 B" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="15"><StackPanel><TextBlock Text="本次会话" Foreground="#8E8E93" FontSize="9" /><TextBlock x:Name="SessionTrafficText" Text="0 B" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel></Border>
              <Border Grid.Column="4" Style="{StaticResource PanelBorder}" Padding="15"><StackPanel><TextBlock Text="套餐累计" Foreground="#8E8E93" FontSize="9" /><TextBlock x:Name="TotalTrafficText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel></Border>
            </Grid>
          </Grid>

          <Grid x:Name="AccountView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="设备与套餐" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="当前绑定状态与使用额度" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0" /></StackPanel>
            <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="22">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="58" Height="58" CornerRadius="16" Background="#E8F2FF" HorizontalAlignment="Left"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="#007AFF" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="MemberText" Text="—" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="DeviceSecurityText" Text="—" Foreground="#6E6E73" FontSize="9" Margin="0,5,0,0" TextWrapping="Wrap" /><TextBlock x:Name="ExpiryText" Text="—" Foreground="#6E6E73" FontSize="9" Margin="0,4,0,0" /></StackPanel>
              </Grid>
            </Border>
            <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Padding="22">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid><TextBlock Text="套餐流量" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="QuotaText" Text="—" HorizontalAlignment="Right" Foreground="#6E6E73" FontSize="10" /></Grid>
                <ProgressBar Grid.Row="2" x:Name="UsageProgress" Minimum="0" Maximum="100" Value="0" />
                <Button Grid.Row="4" x:Name="ResetBindingButton" Width="132" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="ResetBindingButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" Margin="0,0,6,0" /><TextBlock Text="重新绑定设备" FontSize="10" /></StackPanel></Button>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <Border Grid.Row="2" Background="#25FFFFFF" CornerRadius="0,0,26,26" BorderBrush="#65FFFFFF" BorderThickness="0,1,0,0">
        <Grid Margin="16,0"><TextBlock x:Name="FooterText" Text="设备认证已就绪" Foreground="#8E8E93" FontSize="8.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="VersionText" Text="v2.5.0" Foreground="#8E8E93" FontSize="8.5" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid>
      </Border>

      <Grid x:Name="UpdateOverlay" Grid.RowSpan="3" Panel.ZIndex="80" Background="#B3F5F5F7" Visibility="Collapsed">
        <Border Width="420" Padding="30" CornerRadius="26" Background="{StaticResource SurfaceBrush}" BorderBrush="White" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="35" ShadowDepth="8" Opacity="0.22" /></Border.Effect>
          <StackPanel>
            <Border Width="62" Height="62" CornerRadius="16" Background="#E8F2FF" HorizontalAlignment="Center"><TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" Foreground="#007AFF" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock x:Name="UpdateTitleText" Text="发现重要更新" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
            <TextBlock x:Name="UpdateVersionText" Text="正在检查版本" Foreground="#007AFF" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <TextBlock x:Name="UpdateNotesText" Text="更新后才能继续使用壹色云桥。" Foreground="#6E6E73" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18" Margin="0,16,0,0" />
            <ProgressBar x:Name="UpdateProgress" Margin="0,20,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="UpdateProgressText" Foreground="#8E8E93" FontSize="8.5" HorizontalAlignment="Center" Margin="0,7,0,0" />
            <Button x:Name="UpdateNowButton" Height="44" Style="{StaticResource PrimaryButton}" Click="UpdateNowButton_Click" Margin="0,20,0,0"><TextBlock x:Name="UpdateActionText" Text="立即更新" Foreground="White" FontWeight="SemiBold" /></Button>
            <Button x:Name="UpdateLaterButton" Height="36" Style="{StaticResource SecondaryButton}" Click="UpdateLaterButton_Click" Margin="0,8,0,0" Visibility="Collapsed">稍后更新</Button>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
  </Viewbox>
</Window>
