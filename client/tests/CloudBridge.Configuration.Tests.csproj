<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the real boundary, not a second-language model. No WPF or device code. -->
    <Compile Include="..\ClientConfiguration.cs" Link="ClientConfiguration.cs" />
    <Compile Include="..\ControlApiClient.cs" Link="ControlApiClient.cs" />
    <Compile Include="..\ControlTransport.cs" Link="ControlTransport.cs" />
    <Compile Include="..\Models.cs" Link="Models.cs" />
  </ItemGroup>
</Project>
