# Copy to .env and supply your own values. Never commit populated configuration.
# Node: node --env-file=.env server/index.mjs
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data
DIST_DIR=./dist
PRODUCT_NAME=壹色云桥
COOKIE_SECURE=true
# Enable only behind your trusted reverse proxy; the supplied nginx template replaces forwarded headers.
TRUST_PROXY=false
SESSION_DAYS=7
CREDENTIAL_HOURS=24

# Update enforcement remains disabled until real release metadata is supplied.
# Never publish a placeholder checksum/size or an unverified download URL.
CLIENT_UPDATE_VERSION=
CLIENT_MINIMUM_VERSION=
CLIENT_UPDATE_URL=
CLIENT_UPDATE_SHA256=
CLIENT_UPDATE_FILE_SIZE=
CLIENT_UPDATE_RELEASE_NOTES=
CLIENT_UPDATE_PUBLISHED_AT=

# Generate locally with deploy/generate-secrets.mjs --apply NEW_FILE, then copy values privately.
# There are deliberately no usable example passwords, encryption keys, or API tokens.
SETUP_TOKEN=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
CREDENTIAL_ENCRYPTION_KEY=

# Reserved examples are not live infrastructure. Set your own host before enrolling devices.
PROXY_HOST=proxy.example.invalid
PROXY_PORT=443
PROXY_SERVER_NAME=proxy.example.invalid
# Loopback by default. Set your intended public bind explicitly for a real deployment.
DATA_PLANE_HOST=127.0.0.1
DATA_PLANE_PORT=443
DATA_PLANE_INTERNAL_HOST=127.0.0.1
DATA_PLANE_INTERNAL_PORT=2443
# Use absolute certificate/key paths in production. Empty paths leave certificate services unconfigured.
DATA_PLANE_CERT_PATH=
DATA_PLANE_KEY_PATH=
DEVICE_CA_CERT_PATH=
DEVICE_CA_KEY_PATH=
OPENSSL_PATH=/usr/bin/openssl

# Configure an already-authorized, least-privilege token manually. Helpers never create API tokens.
# Example, only with a token and VLESS ID: http://127.0.0.1:2095/app/apiv2
SUI_API_URL=
SUI_API_TOKEN=
SUI_VLESS_INBOUND_ID=
SUI_TUIC_INBOUND_ID=
TUIC_ENABLED=false
TUIC_PORT=443
TUIC_CONGESTION_CONTROL=bbr
# Deployment-helper-only override; set 0.0.0.0 or :: explicitly if public UDP is intended.
TUIC_LISTEN_HOST=127.0.0.1

# Optional read-only checks. These do nothing until health-check.sh --check is used.
HEALTH_CONSOLE_URL=http://127.0.0.1:8787/api/bootstrap
HEALTH_SERVICE_UNITS=
HEALTH_TUIC_PORT=
# Legacy adapter endpoint only; keep unset unless deliberately supporting it.
# PROXY_ADAPTER_TOKEN=
